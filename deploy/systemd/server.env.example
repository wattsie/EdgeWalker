# Change the loopback address to the IP assigned to the server's test interface
# before accepting remote tests. Capacity is bits per second in each direction.
EDGEWALKER_LISTEN=127.0.0.1:62000
EDGEWALKER_CAPACITY=1000000
EDGEWALKER_DATA_PORTS=62001-62008
# Maximum final TCP receipt wait in milliseconds (1 to 30000).
EDGEWALKER_DRAIN_MAX_MS=5000
